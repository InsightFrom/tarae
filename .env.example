# Tarae — Environment Variables (template)
# Copy to .env and fill in values

# LLM
TARAE_OPENAI_API_KEY=sk-xxx
TARAE_LITELLM_MODEL=gpt-4o

# JWT
TARAE_JWT_SECRET=change-me-in-production

# Email (optional)
TARAE_SMTP_HOST=
TARAE_SMTP_PORT=587
TARAE_SMTP_USER=
TARAE_SMTP_PASSWORD=

# Slack (optional)
TARAE_SLACK_WEBHOOK_URL=

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

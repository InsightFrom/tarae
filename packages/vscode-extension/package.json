{
  "name": "tarae",
  "displayName": "Tarae",
  "description": "Read local Tarae coding-session history and generate session reports from VS Code.",
  "version": "0.1.10",
  "publisher": "insightfrom",
  "license": "MIT",
  "icon": "resources/tarae.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/InsightFrom/tarae.git",
    "directory": "packages/vscode-extension"
  },
  "bugs": {
    "url": "https://github.com/InsightFrom/tarae/issues"
  },
  "homepage": "https://github.com/InsightFrom/tarae#readme",
  "keywords": [
    "tarae",
    "mcp",
    "history",
    "ai"
  ],
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "scripts": {
    "check": "node -e \"const fs=require('fs'); const cp=require('child_process'); for (const file of fs.readdirSync('src').filter((name)=>name.endsWith('.js'))) cp.execFileSync(process.execPath, ['--check', 'src/'+file], {stdio:'inherit'});\"",
    "vsix": "npx --yes @vscode/vsce package --no-dependencies",
    "publish": "npx --yes @vscode/vsce publish"
  },
  "activationEvents": [
    "onView:tarae.runtime",
    "onView:tarae.sessions",
    "onCommand:tarae.openDashboard",
    "onCommand:tarae.listSessions",
    "onCommand:tarae.searchHistory",
    "onCommand:tarae.openSessionMarkdown",
    "onCommand:tarae.configureLlmProvider",
    "onCommand:tarae.generateSessionReport",
    "onCommand:tarae.clearLlmCredentials",
    "onCommand:tarae.upgradeLocalRuntime",
    "onCommand:tarae.restartTopaDaemon",
    "onCommand:tarae.refreshSessions"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tarae",
          "title": "Tarae",
          "icon": "resources/tarae.svg"
        }
      ]
    },
    "views": {
      "tarae": [
        {
          "type": "webview",
          "id": "tarae.runtime",
          "name": "Runtime"
        },
        {
          "id": "tarae.sessions",
          "name": "Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "tarae.openDashboard",
        "title": "Tarae: Open Dashboard"
      },
      {
        "command": "tarae.listSessions",
        "title": "Tarae: List Sessions"
      },
      {
        "command": "tarae.searchHistory",
        "title": "Tarae: Search History"
      },
      {
        "command": "tarae.openSessionMarkdown",
        "title": "Tarae: Open Session Markdown"
      },
      {
        "command": "tarae.refreshSessions",
        "title": "Tarae: Refresh Sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "tarae.configureLlmProvider",
        "title": "Tarae: Configure LLM Provider"
      },
      {
        "command": "tarae.generateSessionReport",
        "title": "Tarae: Generate Session Report"
      },
      {
        "command": "tarae.clearLlmCredentials",
        "title": "Tarae: Clear LLM Credentials"
      },
      {
        "command": "tarae.upgradeLocalRuntime",
        "title": "Tarae: Upgrade Local Runtime"
      },
      {
        "command": "tarae.restartTopaDaemon",
        "title": "Tarae: Restart Topa Daemon"
      }
    ],
    "configuration": {
      "title": "Tarae",
      "properties": {
        "tarae.llm.provider": {
          "type": "string",
          "enum": [
            "openai"
          ],
          "default": "openai",
          "description": "LLM provider used for Tarae session report generation."
        },
        "tarae.llm.model": {
          "type": "string",
          "default": "gpt-4.1-mini",
          "description": "Model used for Tarae session report generation."
        },
        "tarae.reports.autoSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically save generated Tarae reports under .tarae/topa/reports/ after preview generation."
        },
        "tarae.runtime.autoUpgrade": {
          "type": "boolean",
          "default": true,
          "description": "Automatically run the local Tarae CLI upgrade flow when the VS Code extension version is newer than the installed tarae/topa runtime."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "tarae.openDashboard",
          "when": "view == tarae.sessions",
          "group": "navigation@1"
        },
        {
          "command": "tarae.refreshSessions",
          "when": "view == tarae.sessions",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "tarae.openSessionMarkdown",
          "when": "viewItem == taraeSession",
          "group": "inline"
        },
        {
          "command": "tarae.generateSessionReport",
          "when": "viewItem == taraeSession",
          "group": "navigation"
        },
        {
          "command": "tarae.openDashboard",
          "when": "viewItem == taraeSession",
          "group": "navigation"
        }
      ]
    }
  }
}
